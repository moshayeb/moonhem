# Copy this file to `.env` in the same folder (project root) and fill in values.
# Used by `backend/config.py` for PostgreSQL and CORS.
#
# Quick local DB: `docker compose up -d` then use DATABASE_NAME=MoonHem and PASSWORD=postgres
# (defaults in docker-compose.yml). Then run: python backend/db_setup.py && python backend/seed.py

# --- Required (database) ---
DATABASE_NAME=MoonHem
PASSWORD=your_postgres_password_here

# Optional aliases (same meaning as above)
# POSTGRES_DB=MoonHem
# POSTGRES_PASSWORD=your_postgres_password_here

# Optional connection overrides
# POSTGRES_USER=postgres
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# Optional: comma-separated origins for the React dev server / production site
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
